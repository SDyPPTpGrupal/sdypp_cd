# Claves: la carpeta entera es un volumen de ejecución. No se versiona NADA de
# adentro — ni las privadas, obviamente, ni las públicas, que son por instalación
# y las genera la consola. Antes sólo se ignoraba `claves/id_deploy`, y una clave
# con cualquier otro nombre (id_deploy_python, por ejemplo) se colaba al repo.
claves/*
!claves/.gitkeep

# Logs y bitácoras
logs/*.log
!logs/.gitkeep

# Archivos de entorno
.env
*.env

# Estado y colas de entrantes (volúmenes de ejecución)
python/entrante/*
!python/entrante/.gitkeep
!python/entrante/rechazados/
!python/entrante/historial/
python/entrante/rechazados/*
!python/entrante/rechazados/.gitkeep
python/entrante/historial/*
!python/entrante/historial/.gitkeep
python/estado/*
!python/estado/.gitkeep

java/entrante/*
!java/entrante/.gitkeep
!java/entrante/rechazados/
!java/entrante/historial/
java/entrante/rechazados/*
!java/entrante/rechazados/.gitkeep
java/entrante/historial/*
!java/entrante/historial/.gitkeep
java/estado/*
!java/estado/.gitkeep

# Bloqueos y temporales
*.lock
*.tmp

# Cachés de Python y artefactos de las pruebas
__pycache__/
*.pyc
tests/e2e/app/contrato.proto
